generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  BARBERSHOP_ADMIN
  SUPER_ADMIN
}

enum BookingStatus {
  CONFIRMED
  COMPLETED
  CANCELLED
}

model User {
  reviews Review[]
  id          String      @id @default(uuid())
  email       String      @unique
  password    String?
  barbershops Barbershop[]
  tell        String?
  image       String?
  name        String
  createdAt   DateTime    @default(now())
  update      DateTime    @updatedAt
  bookings    Booking[]
  role        Role        @default(USER) 
}

model Barbershop {
  reviews Review[]
  id            String              @id @default(uuid())
  name          String
  address       String
  phones        String[]
  ownerId       String
  owner         User                @relation(fields: [ownerId], references: [id])
  workingHours  WorkingHours[]
  professionals Professional[]
  description   String
  imageUrl      String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  services      BarbershopService[]
}

model BarbershopService {
  durationMinutes Int @default(30)
  id           String         @id @default(uuid())
  name         String
  description  String
  imageUrl     String
  price        Decimal        @db.Decimal(10, 2)
  barbershopId String
  barbershop   Barbershop     @relation(fields: [barbershopId], references: [id])
  bookings     Booking[]
  professionals Professional[]
}

enum PaymentMethod {
  DINHEIRO
  CARTAO_DEBITO
  CARTAO_CREDITO
  PIX
  OUTRO
}

model Booking {
  priceAtBooking Decimal @default(0) @db.Decimal(10, 2)
  paidAmount Decimal? @db.Decimal(10, 2)
  paymentMethod PaymentMethod?
  paidAt DateTime?
  status BookingStatus @default(CONFIRMED)
  review Review?
  durationMinutes Int @default(30)
  endsAt DateTime @default(now())
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  serviceId      String
  service        BarbershopService @relation(fields: [serviceId], references: [id])
  date           DateTime
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  professionalId String
  professional   Professional      @relation(fields: [professionalId], references: [id])
}

model WorkingHours {
  id           String     @id @default(uuid())
  dayOfWeek    Int
  startTime    String
  endTime      String
  isOpen       Boolean    @default(true)
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])

  @@unique([barbershopId, dayOfWeek])
}

model Professional {
  id           String     @id @default(uuid())
  name         String
  imageUrl     String?
  barbershopId String
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])
  bookings     Booking[]
  services     BarbershopService[]
}


model Review {
  id String @id @default(uuid())
  bookingId String @unique
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  barbershopId String
  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Restrict)
  rating Int
  comment String?
  createdAt DateTime @default(now())

  @@index([barbershopId, createdAt])
}
